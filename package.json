{
  "name": "realitin-ar",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "models:optimize": "node scripts/optimize-models.mjs",
    "models:check": "node scripts/check-models.ts",
    "wp:vendor": "node scripts/wp-plugin-vendor.mjs",
    "wp:dev": "npm run wp:vendor && npx -y @wp-playground/cli@3.1.58 server --port=9400 --login --blueprint=wordpress-plugin/dev/blueprint.json --mount=./wordpress-plugin/realitin-ar:/wordpress/wp-content/plugins/realitin-ar --mount=./wordpress-plugin/dev/mu-plugins:/wordpress/wp-content/mu-plugins --mount=./wordpress-plugin/dev:/realitin-dev --mount=./public/models:/realitin-models",
    "wp:zip": "npm run wp:vendor && mkdir -p dist-plugin && rm -f dist-plugin/realitin-ar.zip && cd wordpress-plugin && zip -rq ../dist-plugin/realitin-ar.zip realitin-ar -x '*.DS_Store' && echo dist-plugin/realitin-ar.zip",
    "wp:dev:public": "npm run wp:vendor && npx -y @wp-playground/cli@3.1.58 server --port=9400 --site-url=$WP_SITE_URL --blueprint=wordpress-plugin/dev/blueprint.json --mount=./wordpress-plugin/realitin-ar:/wordpress/wp-content/plugins/realitin-ar --mount=./wordpress-plugin/dev:/realitin-dev --mount=./public/models:/realitin-models"
  },
  "dependencies": {
    "@google/model-viewer": "^4.4.0",
    "@huggingface/transformers": "^4.3.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "three": "^0.183.2"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  }
}
