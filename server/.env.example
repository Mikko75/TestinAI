# Kopioi tämä tiedostoksi server/.env ja täytä arvot. server/.env ei mene Gitiin.

# Avain, jolla WordPress-lisäosa tunnistautuu palveluun. Keksi pitkä satunnainen merkkijono,
# esim. komennolla: openssl rand -hex 32
REALITIN_API_KEY=

# mock = palauttaa valmiin esimerkkimallin (ei kuluja), tripo = oikea generointi Tripolla
REALITIN_PROVIDER=mock

# Tripo-API-avain (platform.tripo3d.ai -> API Keys). Tarvitaan vain, kun REALITIN_PROVIDER=tripo.
TRIPO_API_KEY=

# Valinnaiset
# PORT=8787
# TRIPO_API_BASE=https://openapi.tripo3d.ai/v3
# TRIPO_MODEL=v3.1-20260211
# Jos generoitu malli osoittaa sivulle, korjaa kierto (astetta pystyakselin ympäri), esim. -90
# TRIPO_FRONT_ROTATION_DEG=0
